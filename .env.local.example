# Fallback only. Payment return links use the domain the customer is actually on.
SITE_URL=https://booking.thedivinetarotonline.com
PRICE_INR=8500
CALL_MINUTES=40
ADMIN_TOKEN=set-a-long-random-password-here

# Firebase (Firestore). EASIEST: paste the whole downloaded JSON as ONE line inside single quotes:
# FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"...", ...}'
# (or use the 3 vars below — all three must come from the SAME json file)
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Razorpay (Payment Links API + webhook event: payment_link.paid)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Google Calendar OAuth (scope: calendar.events) of the reading calendar's account
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Emails (SMTP): payment-received mail, client confirmation (Meet link + schedule), owner copy of the form with photos.
# Gmail example: smtp.gmail.com / 465 / your address + an App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM="The Divine Tarot" <thedivinetarothindi@gmail.com>
OWNER_EMAIL=thedivinetarothindi@gmail.com
