# Fallback only. Payment return links use the domain the customer is actually on.
SITE_URL=https://booking.thedivinetarotonline.com
PRICE_INR=8500
PRICE_URGENT_INR=17000
# Signs the cookie that unlocks the form after payment (optional; defaults to RAZORPAY_KEY_SECRET)
FORM_SECRET=
CALL_MINUTES=40
ADMIN_TOKEN=set-a-long-random-password-here

# Firebase (Firestore). EASIEST: paste the whole downloaded JSON as ONE line inside single quotes:
# FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"...", ...}'
# (or use the 3 vars below — all three must come from the SAME json file)
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Razorpay (Payment Links API + webhook event: payment_link.paid)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Google Calendar OAuth (scope: calendar.events) of the reading calendar's account
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Emails (SMTP): payment-received mail, client confirmation (Meet link + schedule), owner copy of the form with photos.
# Gmail example: smtp.gmail.com / 465 / your address + an App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM="The Divine Tarot" <dev.thedivinetarot111@gmail.com>
# Form copy goes to every address here — separate several with commas: a@gmail.com,b@gmail.com
OWNER_EMAIL=dev.thedivinetarot111@gmail.com,thedivinetarot111@gmail.com

# Added to every calendar event / Meet as guests, besides the customer (comma-separated). Optional — these two are the default.
CALENDAR_GUESTS=dev.thedivinetarot111@gmail.com,thedivinetarot111@gmail.com
