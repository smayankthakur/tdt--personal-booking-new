SITE_URL=https://booking.thedivinetarotonline.com
PRICE_INR=8500
CALL_MINUTES=40
ADMIN_TOKEN=set-a-long-random-password-here

# Firebase (Firestore). EASIEST: paste the whole downloaded JSON as ONE line inside single quotes:
# FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"...", ...}'
# (or use the 3 vars below — all three must come from the SAME json file)
FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"your-project-id","private_key":"-----BEGIN PRIVATE KEY-----
YOUR_PRIVATE_KEY_HERE
-----END PRIVATE KEY-----
","client_email":"your-service-account@your-project.iam.gserviceaccount.com"}'
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
YOUR_PRIVATE_KEY_HERE
-----END PRIVATE KEY-----"

# Razorpay (Payment Links API + webhook event: payment_link.paid)
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET

# Google Calendar OAuth (scope: calendar.events) of the reading calendar's account
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Emails (SMTP): payment-received mail, client confirmation (Meet link + schedule), owner copy of the form with photos.
# Gmail example: smtp.gmail.com / 465 / your address + an App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=YOUR_APP_PASSWORD
SMTP_FROM="The Divine Tarot" <your-email@gmail.com>
OWNER_EMAIL=your-email@gmail.com
